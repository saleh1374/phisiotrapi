# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# postgres (default) or sqlite3 (quick local dev without PostgreSQL)
DATABASE_ENGINE=postgres
POSTGRES_DB=physio_clinic
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OTP / SMS ---
# console = print code to server log (development). Production: kavenegar etc.
OTP_SMS_BACKEND=console
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5