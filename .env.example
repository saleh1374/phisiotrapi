# ============================================================
# کلینیک فیزیوتراپی — متغیرهای محیطی
# این فایل را به .env تغییر نام دهید و مقادیر را تنظیم کنید.
# ============================================================

# --- دیتابیس (PostgreSQL) ---
POSTGRES_DB=physio_clinic
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio

# --- بک‌اند ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# در صورت نداشتن PostgreSQL برای توسعه سریع: sqlite3
DATABASE_ENGINE=postgres

# --- ورود با گوگل ---
# OAuth Client ID از کنسول گوگل (هر دو مقدار یکسان هستند)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- فرانت‌اند ---
# آدرس API بک‌اند (برای مرورگر کاربر)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# آدرس عمومی سایت (برای sitemap/robots و QR کدها در تولید)
NEXT_PUBLIC_SITE_URL=http://localhost:3000